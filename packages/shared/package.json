{
  "name": "@jaisheel41/devdeck-shared",
  "version": "0.1.0",
  "description": "Types shared by the DevDeck daemon and dashboard.",
  "license": "MIT",
  "author": "Jaisheel Polimera <jaisheel42@gmail.com> (https://github.com/jaisheel41)",
  "keywords": [
    "devdeck",
    "types"
  ],
  "homepage": "https://github.com/jaisheel41/DevDeck#readme",
  "bugs": {
    "url": "https://github.com/jaisheel41/DevDeck/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaisheel41/DevDeck.git",
    "directory": "packages/shared"
  },
  "private": false,
  "type": "module",
  "files": [
    "dist",
    "package.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}

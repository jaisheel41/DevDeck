{
  "name": "@jaisheel41/devdeck",
  "version": "0.1.3",
  "description": "Local dashboard and CLI for starting dev services, streaming logs, and checking env and Postgres.",
  "license": "MIT",
  "author": "Jaisheel Polimera <jaisheel42@gmail.com> (https://github.com/jaisheel41)",
  "keywords": [
    "devdeck",
    "cli",
    "dashboard",
    "developer-tools",
    "process-manager",
    "localhost"
  ],
  "homepage": "https://github.com/jaisheel41/DevDeck#readme",
  "bugs": {
    "url": "https://github.com/jaisheel41/DevDeck/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaisheel41/DevDeck.git",
    "directory": "packages/daemon"
  },
  "type": "module",
  "bin": {
    "devdeck": "./bin/devdeck.cjs"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "bin",
    "public",
    "package.json"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node --import tsx dist/index.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "node --import tsx --test test/cli.test.ts test/config.test.ts test/envManager.test.ts test/initDetect.test.ts test/processManager.test.ts test/quickRun.test.ts",
    "prepublishOnly": "tsc -p tsconfig.json && node ./scripts/prepublish.mjs"
  },
  "dependencies": {
    "@jaisheel41/devdeck-shared": "workspace:*",
    "tsx": "^4.19.2",
    "chokidar": "^4.0.3",
    "express": "^4.21.2",
    "pidusage": "^3.0.2",
    "pg": "^8.13.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.2"
  }
}
